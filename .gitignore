# This .gitignore file should be placed at the root of your Unity project directory
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# ─────────────────────────────
# Core Unity folders
# ─────────────────────────────
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# ─────────────────────────────
# Blender auto files
# ─────────────────────────────
*.blend1
*.blend1.meta

# ─────────────────────────────
# Memory & Recordings
# ─────────────────────────────
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ─────────────────────────────
# Optional / plugin tools
# ─────────────────────────────
# /[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ─────────────────────────────
# IDE / Editor caches
# ─────────────────────────────
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta crash reports
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# ─────────────────────────────
# Build outputs
# ─────────────────────────────
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.ipa  # iOS build output
*.dSYM.zip
*.dSYM

# ─────────────────────────────
# Crashlytics
# ─────────────────────────────
crashlytics-build.properties

# ─────────────────────────────
# Addressables / StreamingAssets
# ─────────────────────────────
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ─────────────────────────────
# Visual Scripting auto-generated
# ─────────────────────────────
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ─────────────────────────────
# iOS / Xcode specific ignores
# ─────────────────────────────
# Build artifacts and caches
DerivedData/
*.xcuserstate
*.xcuserdatad/
*.xccheckout
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
*.xcuserdata/
*.xcscheme
Pods/
Podfile.lock
.idea/
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcsettings
*.xcworkspace.zip
*.mobileprovision
*.plist

# Fastlane / archive outputs
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Archive artifacts
*.xcarchive
ExportOptions.plist

# ─────────────────────────────
# Unity Cloud Build temporary
# ─────────────────────────────
/[Uu]ser[Ll]ibrary/
/[Cc]ache/
/[Ll]ogs/

# ─────────────────────────────
# macOS system files
# ─────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db