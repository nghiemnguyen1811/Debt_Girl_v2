    m_Metadata:
      m_Items: []
  - m_Id: 19973037965312
    m_Localized: "\uBCF4\uC308"
    m_Metadata:
      m_Items: []
  - m_Id: 19973646139392
    m_Localized: "\uC0C1\uCD94\uC640 \uD568\uAED8 \uC990\uAE30\uB294 \uC0B6\uC740
