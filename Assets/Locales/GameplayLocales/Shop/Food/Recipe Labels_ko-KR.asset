      m_Items: []
  - m_Id: 20388081123328
    m_Localized: "\uC9EC\uBF55"
    m_Metadata:
      m_Items: []
  - m_Id: 20388685103104
    m_Localized: "\uD574\uC0B0\uBB3C\uC774 \uB4E4\uC5B4\uAC04 \uB9E4\uC6B4 \uAD6D\uBB3C\uBA74\uC774\uC5D0\uC694."
