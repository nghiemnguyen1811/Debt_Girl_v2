      m_Items: []
  - m_Id: 20052989788160
    m_Localized: "\uC5B4\uBB35\uBCF6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 20053572796416
    m_Localized: "\uCC44\uC18C\uC640 \uD568\uAED8 \uBCF6\uC740 \uC5B4\uBB35 \uBC18\uCC2C\uC774\uC5D0\uC694."
