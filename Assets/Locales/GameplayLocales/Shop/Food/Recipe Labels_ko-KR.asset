      m_Items: []
  - m_Id: 20258313551872
    m_Localized: "\uC9DC\uC7A5\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 20258921725952
    m_Localized: "\uC9ED\uC9E4\uD55C \uCD98\uC7A5 \uC18C\uC2A4\uC758 \uBA74\uC694\uB9AC\uC608\uC694."
