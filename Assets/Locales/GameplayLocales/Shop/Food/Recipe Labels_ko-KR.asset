      m_Items: []
  - m_Id: 20385732313088
    m_Localized: "\uC7A1\uCC44"
    m_Metadata:
      m_Items: []
  - m_Id: 20386327904256
    m_Localized: "\uCC44\uC18C\uC640 \uC18C\uACE0\uAE30\uB97C \uB123\uC740 \uB2F9\uBA74
